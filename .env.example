# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL / Supabase Database Connection URL (leave empty to use local SQLite)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Supabase Storage Configuration (uploads KYC docs, deposit proofs, P2P receipts, avatars)
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="nepefy-uploads"

# Strong JWT Signing Secret (generate a 64-char random string in production)
JWT_SECRET="CHANGE_ME_TO_A_STRONG_64_CHAR_RANDOM_SECRET"

# Production Email OTP Delivery
# Method 1: Resend API (requires verified domain at resend.com/domains)
RESEND_API_KEY=""
# Method 2: Gmail SMTP (no custom domain needed; use a 16-char Google App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS=""
# Optional shorthand aliases for Method 2 (Gmail): GMAIL_USER / GMAIL_APP_PASSWORD
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
EMAIL_FROM="Nepefy <your-gmail@gmail.com>"

# Server Listen Port (defaults to 3000)
PORT="3000"

# Set to "true" only if deploying before configuring Resend or SMTP email OTP delivery
ALLOW_OTP_PREVIEW="false"

# Optional Initial Master Administrator Bootstrap (used only on fresh empty DB)
INITIAL_ADMIN_EMAIL="admin@yourdomain.com"
INITIAL_ADMIN_PASSWORD=""
